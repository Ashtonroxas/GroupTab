rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isTripMember(tripId) {
      return request.auth != null
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/shared_trips/$(tripId)
        ).data.members;
    }

    match /shared_trips/{tripId}/receipt-covers/{location}/{fileName} {
      allow read: if isTripMember(tripId);
      allow create: if isTripMember(tripId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isTripMember(tripId);
    }

    match /shared_trips/{tripId}/receipt-photos/{location}/{fileName} {
      allow read: if isTripMember(tripId);
      allow create: if isTripMember(tripId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isTripMember(tripId);
    }

    match /shared_trips/{tripId}/trip-covers/{fileName} {
      allow read: if isTripMember(tripId);
      allow create: if isTripMember(tripId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isTripMember(tripId);
    }
  }
}
