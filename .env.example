# Example local env vars (do NOT commit real secrets)
FLASK_ENV=development
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
# Optional: Redis URL for limiter (e.g., redis://localhost:6379)
REDIS_URL=
# Either set FIREBASE_SERVICE_ACCOUNT_JSON (not recommended) or point to a local file
FIREBASE_SERVICE_ACCOUNT_FILE=./serviceAccount.json
# Optional fallback API key
X_API_KEY=