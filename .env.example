# Example local env vars (do NOT commit real secrets)
FLASK_ENV=development
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
# Optional: Redis URL for limiter (e.g., redis://localhost:6379)
REDIS_URL=
# Required for production API requests to verify Firebase user tokens.
FIREBASE_PROJECT_ID=your-project-id
# Optional alternative for server-side Firebase Admin verification. Never commit a real key.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Optional fallback API key
X_API_KEY=
